+    /// Flash mod bridge JSON-RPC ΓÇö live AVM get/set/call/find/SharedObject.
+    ///
+    /// `request_json` example: `{"op":"ping"}` or
+    /// `{"op":"set","path":"so:save|allmoney","value":999999}`
+    ///
+    /// Returns a JSON string: `{"ok":true,...}` or `{"ok":false,"error":"..."}`.
+    #[wasm_bindgen(js_name = "modBridgeRpc")]
+    pub fn mod_bridge_rpc(&self, request_json: String) -> String {
+        self.with_core_mut(|core| core.mod_bridge_rpc(&request_json))
+            .unwrap_or_else(|e| format!(r#"{{"ok":false,"error":"core lock: {e}"}}"#))
+    }
+
+    /// Convenience: pass `op` + a plain object of extra fields (merged into the RPC).
+    #[wasm_bindgen(js_name = "modBridge")]
+    pub fn mod_bridge(&self, op: String, fields: JsValue) -> String {
+        let obj = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&obj, &JsValue::from_str("op"), &JsValue::from_str(&op));
+        if fields.is_object() {
+            let src = js_sys::Object::from(fields);
+            for key in js_sys::Object::keys(&src) {
+                if let Some(k) = key.as_string() {
+                    if let Ok(v) = js_sys::Reflect::get(&src, &key) {
+                        let _ = js_sys::Reflect::set(&obj, &JsValue::from_str(&k), &v);
+                    }
+                }
+            }
+        }
+        match js_sys::JSON::stringify(&obj) {
+            Ok(s) => self.mod_bridge_rpc(String::from(s)),
+            Err(e) => format!(r#"{{"ok":false,"error":"stringify: {e:?}"}}"#),
+        }
+    }
+
